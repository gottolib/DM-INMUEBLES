# Copiá este archivo a ".env" y completá los valores.
# En desarrollo local podés dejar casi todo tal cual está acá.

# --- Base de datos ---
# En desarrollo: SQLite, un solo archivo, no requiere instalar nada.
DATABASE_URL="file:./dev.db"
# En producción (recomendado): PostgreSQL. Solo cambiás esta línea y
# el "provider" en prisma/schema.prisma de "sqlite" a "postgresql".
# DATABASE_URL="postgresql://usuario:password@host:5432/basededatos"

# --- Autenticación del panel /admin ---
# Generá un valor random único, por ejemplo con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-por-un-valor-aleatorio-largo"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del usuario administrador que crea el "seed" (ver README).
ADMIN_EMAIL="admin@dminmobiliaria.com"
ADMIN_PASSWORD="CambiarEstaClave123"
ADMIN_NAME="Administrador DM Inmobiliaria"

# --- WhatsApp / contacto ---
# Número completo con código de país, sin signos ni espacios. Ej: Argentina 54 9 + código de área + número.
WHATSAPP_NUMBER="5493777123456"
NEXT_PUBLIC_WHATSAPP_NUMBER="5493777123456"

# --- Sitio ---
# URL pública del sitio (se usa para el sitemap y metadatos SEO).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Almacenamiento de imágenes ---
# "local": guarda las imágenes en /public/uploads/propiedades. Funciona en
#          desarrollo y en un servidor propio con disco persistente.
#          NO FUNCIONA EN VERCEL (filesystem de solo lectura).
# "cloudinary": sube las imágenes a Cloudinary (plan gratuito disponible).
#          Necesita completar CLOUDINARY_URL abajo. Usá esta opción si vas
#          a desplegar en Vercel (ver README, sección Deploy).
STORAGE_PROVIDER="local"

# Solo necesario si STORAGE_PROVIDER="cloudinary". Lo obtenés gratis en
# https://cloudinary.com/users/register/free -> Dashboard -> "API Environment variable".
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL="cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz@tu-cloud-name"
